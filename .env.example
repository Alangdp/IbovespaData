NODE_ENV=development
PORT=3000

# Redis (cache dos dados e fila de atualização)
REDIS_HOST=localhost
REDIS_PORT=6379

# Tempo (em horas) para considerar o cache de pontuação / ranking desatualizado
TOLERANCE_TIME_HOURS=1
TOLERANCE_TIME_HOURS_RANKING=24

# Rotas /fundos: sem token a brapi.dev só responde MXRF11 e HGLG11 (sandbox).
# Para os demais FIIs é necessário o plano Pro: https://brapi.dev/dashboard
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api/v2/fii
