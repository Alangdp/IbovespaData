{
  "name": "api-data-market",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:update": "UPDATE_GOLDEN=1 bun test",
    "fixtures:record": "bun tests/support/record.ts",
    "queue:start": "bun scripts/start-queue.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "axios": "1.20.0",
    "bullmq": "6.3.8",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  }
}
